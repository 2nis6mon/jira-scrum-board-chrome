{
  "name": "jira-scrum-board-chrome",
  "version": "0.34.11",
  "private": true,
  "description": "Boards Scrum et Kanban Jira Cloud : swimlanes par objectif, Build et RUN configurables, glisser-déposer et Daily.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build --mode dist",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:transition": "npm run verify:jira",
    "verify:drag": "node scripts/verify-drag.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:planning": "node scripts/verify-planning.mjs",
    "verify:planning:package": "node scripts/verify-planning.mjs --package",
    "verify:load": "npm run build && node scripts/verify-load.mjs",
    "verify:jira": "npm run build && node scripts/verify-jira.mjs",
    "harness": "vite --config vite.harness.config.ts",
    "package": "node scripts/package.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "verify:button": "npm run build && node scripts/verify-button.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/build-site.mjs --check",
    "site:preview": "node scripts/preview-site.mjs",
    "site:verify": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/chrome": "0.3.0",
    "happy-dom": "20.14.5",
    "marked": "17.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
