{
  "manifest_version": 3,
  "name": "Scrum Board",
  "short_name": "Scrum Board",
  "description": "Pilote un sprint Jira par ses objectifs. Jira reste la source de vérité.",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "Ouvrir Scrum Board"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["https://*.atlassian.net/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' blob: data:; connect-src https://*.atlassian.net; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
