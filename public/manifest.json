{
  "manifest_version": 3,
  "name": "Sprint Goals Board pour Jira",
  "short_name": "Sprint Goals",
  "description": "Boards Scrum et Kanban Jira Cloud : swimlanes par objectif, Build et RUN configurables, glisser-déposer et Daily.",
  "version": "0.27.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir Sprint Goals Board",
    "default_popup": "launcher.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "jira-direct-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*.atlassian.net/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' blob: data:; connect-src https://*.atlassian.net; base-uri 'none'; form-action 'none'; frame-ancestors https://*.atlassian.net"
  },
  "web_accessible_resources": [
    {
      "resources": ["board.html", "assets/*", "icons/*"],
      "matches": ["https://*.atlassian.net/*"]
    }
  ]
}
